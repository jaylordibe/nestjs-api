NODE_ENV="development"
# The port the HTTP server binds, on 0.0.0.0. Local dev uses 3000. A container
# platform that injects its own PORT simply wins (8080 is a common choice), so
# nothing here needs changing for a deployment.
PORT=3000

SERVICE_NAME="nestjs"

# Base URL used when building clickable email links (e.g. verification
# links). Point at your frontend if you have one, otherwise at the API
# base — the backend has a GET /auth/verify-email?token=… endpoint that
# handles the click directly. No trailing slash.
API_BASE_URL="http://localhost:3000/api"

# Customer-facing web frontend base URL — distinct from API_BASE_URL
# (which is the API). Used by emails that link customers to pages they
# actually browse (booking confirmation CTAs, marketing pages, etc.).
# Default targets the Vite dev port; production must be set to the real
# web hostname (e.g. https://yourapp.com). No trailing slash.
WEB_BASE_URL="http://localhost:5173"

DB_USER="${SERVICE_NAME}"
DB_PASSWORD="0UFOZeHfdwbzc2aFzj6dv"
DB_HOST="localhost"
DB_PORT=5433
DB_NAME="${SERVICE_NAME}_local"

DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ── Postgres connection pool ─────────────────────────────────────────────────
# Connections THIS process holds open. The number that matters is the product,
# because the API scales horizontally:
#
#   (API max instances × DATABASE_POOL_MAX)
#     + (worker max instances × DATABASE_POOL_MAX)
#     + the migration job
#     + any admin session
#     < the database's max_connections, minus its superuser reserve
#
# Worked example, one API service and one worker, against a server whose
# max_connections is 400 (minus a small superuser reserve):
#   API     max 10 instances × 10 = 100
#   worker  max  3 instances × 10 =  30
#   migration job                 =  10
#   headroom for psql/backup      =  10
#   ──────────────────────────────────
#   total 150, comfortably under the budget.
#
# Raise instance counts OR the pool, never both without redoing the arithmetic.
# If the product exceeds the budget, put a connection pooler (PgBouncer, or
# whatever your managed provider offers) in front, instead of shrinking the pool
# to a number that starves each instance.
DATABASE_POOL_MAX=10
# How long a caller waits for a free connection before failing. Bounded so a
# saturated pool fails fast rather than holding a request open past its deadline.
DATABASE_CONNECTION_TIMEOUT_MS=5000
# How long an idle connection is held before being returned to the database.
DATABASE_IDLE_TIMEOUT_MS=30000

# Host port for the dev stack's MinIO (S3-compatible object storage). The test
# stack uses its own port from .env.test, so the two never collide. Change this
# if something already owns 9000 on your machine.
MINIO_PORT=9000

REDIS_HOST="localhost"
REDIS_PORT=6378
REDIS_PASSWORD="bVVrWPX1HGfiNwZmwZFOkON"
REDIS_URL="redis://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# ── Redis TLS ────────────────────────────────────────────────────────────────
# Off locally: the dev container is reachable only from this machine. ON for any
# managed Redis with in-transit encryption, where it looks like:
#
#   REDIS_URL="rediss://default:<AUTH-string>@10.0.0.3:6378"
#   REDIS_TLS_ENABLED=true
#   REDIS_TLS_CA="-----BEGIN CERTIFICATE-----\n…\n-----END CERTIFICATE-----"
#
# REDIS_TLS_ENABLED and REDIS_URL's scheme MUST agree — boot fails if they do
# not, rather than silently connecting in plaintext while the config claims
# otherwise.
#
# REDIS_TLS_CA is the PEM-encoded CA certificate, and is OPTIONAL: supply it
# when the server certificate is signed by a private or per-instance CA (several
# managed Redis providers do this and publish the CA in their console or CLI),
# omit it when the certificate chains to a publicly-trusted root. Newlines may
# be literal or written as `\n`. Certificate VERIFICATION is not configurable
# and is always on.
REDIS_TLS_ENABLED=false
# REDIS_TLS_CA=""

# Whether THIS process consumes queued jobs and installs recurring job
# schedulers. Producing is never gated — an API-only instance still enqueues,
# the jobs just wait for a consumer.
#
# This single variable is what separates the two production runtimes:
#   API      QUEUE_WORKER_ENABLED=false   node dist/main.js
#   Worker   QUEUE_WORKER_ENABLED=true    node dist/worker.js
# Locally one process does both, which is why the default is true.
QUEUE_WORKER_ENABLED=true
# Jobs a worker runs at once, per queue. Raise for backlog, lower if the worker
# crowds out HTTP traffic in a combined process.
QUEUE_WORKER_CONCURRENCY=10

# REQUIRED: generate a unique value per deployment, e.g. `openssl rand -hex 48`.
# Left blank here so Joi's .min(16).required() check blocks boot on a fresh
# clone — a template-shared secret would let anyone forge tokens for any
# deployment that forgot to regenerate.
JWT_SECRET=""
# Access-token lifetime. Short on purpose: an access token is a signed
# assertion, so nothing can withdraw it once issued — only its expiry bounds a
# leaked one. Clients are expected to refresh rather than hold this for days.
# Raising it past an hour trades away most of the benefit of having a refresh
# flow at all.
JWT_EXPIRES_IN="15m"
# Refresh-token lifetime in whole days — the actual "keep me signed in" window,
# and the one users feel. 30 days matches consumer-app expectations (most
# booking/social apps); users shouldn't have to re-login daily. Unlike the
# access token this one IS revocable — it is a row in `refresh_tokens`, rotated
# on every use, and any replay of an already-exchanged token revokes the whole
# session family. So a long value here is a usability choice, not an unbounded
# liability. For higher-value apps (banking, healthcare, admin consoles), drop
# it to a few days.
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

# OpenTelemetry collector base URL (traces + metrics), e.g.
# "http://otel-collector:4318". LEAVE EMPTY to disable telemetry: with no
# endpoint the SDK never starts, so local development and CI pay nothing.
#
# Deliberately OTLP to a collector rather than a vendor SDK or a scraped
# /metrics endpoint. The exporter is the only part of an observability stack
# you are likely to replace, so the app speaks one open protocol and the
# collector fans out to whatever you buy — Jaeger, Tempo, Honeycomb, Grafana,
# Datadog, or a Prometheus scrape target. Changing backend becomes collector
# config, not an application change.
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Backstop TTL (seconds) for the per-user permission-grants cache in Redis.
# Role and membership changes invalidate the cache explicitly, so this only
# bounds the window of a missed invalidation. Default 300.
AUTHORIZATION_GRANTS_CACHE_TTL_SECONDS=300

# Whether the Cloudflare-injected request headers (CF-Connecting-IP,
# CF-IPCountry, CF-Ray) may be believed and written into audit_logs.
#
# They are ordinary request headers, so anyone who can reach the origin
# directly can set them to whatever they like — including the client IP that
# gets recorded against their own login. Leave this OFF unless the origin is
# provably unreachable except through Cloudflare (see the `cloudflare_only`
# snippet in docs/prod/Caddyfile, which aborts any request from outside CF's
# published ranges). With it off, `ip` is whatever Express resolved via
# TRUST_PROXY and the country/ray fields are simply absent.
TRUST_CLOUDFLARE_HEADERS=false

# How long a business invitation stays redeemable, in whole days. The token is
# a bearer credential sitting in somebody's inbox, so a long window turns any
# later mailbox compromise into a way into the business. Max 30.
BUSINESS_INVITATION_EXPIRES_IN_DAYS=7

# Email provider. `stub` logs messages to stdout — good for local dev and
# tests (OTPs still visible in the console so manual flows work). Set to
# `resend` in staging/prod, supply RESEND_API_KEY + EMAIL_FROM, and make
# sure EMAIL_FROM is on a domain you've verified in the Resend dashboard
# (DKIM + SPF + DMARC set in DNS) — otherwise sends land in spam.
# REFUSED IN PRODUCTION: the stub adapter logs the rendered message body, which
# carries one-time codes and the verify-email link. Boot fails if this is left
# at `stub` with NODE_ENV=production.
EMAIL_PROVIDER="stub"
# EMAIL_FROM="App Name <noreply@yourapp.com>"
# RESEND_API_KEY=""

# SMS provider. `stub` logs messages to stdout — OTPs surface in the app
# console for local flows. Set to `twilio` in staging/prod and supply the
# three TWILIO_* values. TWILIO_FROM may be either an E.164 phone number
# you've provisioned in the Twilio console (e.g. "+15551234567") or a
# Messaging Service SID starting with "MG…".
# Refused in production for the same reason as EMAIL_PROVIDER — the stub adapter
# logs the message body, which is the OTP.
SMS_PROVIDER="stub"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""

# ── Object storage ──────────────────────────────────────────────────────────
# `stub` persists nothing and returns `stub://…` URLs. It is the default, and
# that is deliberate: a fresh clone, local development and the entire test
# suite run with NO cloud account and NO credential of any kind.
#
# Production picks one of `s3`, `gcs`, `azure`. None is privileged, all four
# implement the same interface, and only the selected provider's SDK is loaded
# at runtime — so choosing one costs nothing at startup for the other three.
#
# NOTICE WHAT IS ABSENT: there is no variable here for an access key, a
# service-account JSON, an account key or a connection string, for any provider.
# Each adapter authenticates through its platform's KEYLESS identity chain:
#
#   s3     → the AWS default credential chain (instance profile, ECS task role,
#            EKS IRSA, or AWS_* env vars locally)
#   gcs    → Application Default Credentials (attached service account, or
#            Workload Identity Federation off-platform)
#   azure  → DefaultAzureCredential (managed identity, or an az CLI login)
#
# Long-lived cloud credentials are not an input this application accepts.
STORAGE_PROVIDER="stub"

# Applies to EVERY provider. LEAVE UNSET unless the bucket/container really is
# world-readable or CDN-fronted: unset means the API reports no public URL and
# callers must mint a short-lived signed URL instead, which is the safe default
# and what this template assumes. Setting it is an explicit assertion that
# objects are public — nothing in the application makes them so.
# STORAGE_PUBLIC_URL_BASE="https://cdn.yourapp.com"

# Default lifetime of a signed read URL. Clamped to [30s, 1h] in code whatever
# is set here: a signed URL cannot be revoked, so its lifetime IS the security
# boundary. Authorize the caller BEFORE minting one.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Ceiling on any single call to the storage backend, for every provider. Bounds
# a SLOW backend rather than a dead one: an upload handler awaiting a hung
# request keeps its Postgres connection checked out, so a stalled bucket
# saturates DATABASE_POOL_MAX and fails requests that never touched storage.
STORAGE_REQUEST_TIMEOUT_MS=15000

# --- s3: AWS S3 and any S3-compatible backend (Cloudflare R2, DigitalOcean
#     Spaces, MinIO, Ceph). Region is optional — the SDK resolves it from
#     AWS_REGION, the shared config file, or instance metadata.
#
#     The dev stack already runs MinIO, so you can exercise the real `s3` path
#     locally with no cloud account. Create a bucket in the MinIO console
#     (http://localhost:9000, minioadmin/minioadmin) and uncomment:
#       STORAGE_PROVIDER="s3"
#       STORAGE_S3_ENDPOINT="http://localhost:9000"
#       STORAGE_S3_FORCE_PATH_STYLE="true"
#       STORAGE_S3_BUCKET="uploads"
#       AWS_ACCESS_KEY_ID="minioadmin"
#       AWS_SECRET_ACCESS_KEY="minioadmin"
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION="us-east-1"
# Set only for an S3-compatible backend; leave empty for AWS S3 itself.
# STORAGE_S3_ENDPOINT=""
# STORAGE_S3_FORCE_PATH_STYLE="false"

# --- gcs: Google Cloud Storage. Project ID is optional — supplied it pins the
#     project, omitted ADC decides (what a local `gcloud auth` session expects).
#     Signed URLs need `roles/iam.serviceAccountTokenCreator` on the runtime
#     identity, because with ADC there is no private key in the process.
# STORAGE_GCS_BUCKET=""
# STORAGE_GCS_PROJECT_ID=""

# --- azure: Azure Blob Storage. Signed URLs are user-delegation SAS tokens
#     signed via Entra ID, so no account key is ever needed. The identity needs
#     `Storage Blob Data Contributor` on the container.
# STORAGE_AZURE_ACCOUNT_NAME=""
# STORAGE_AZURE_CONTAINER=""

# Public web URL the API redirects to after a GET /auth/verify-email
# click. The web app reads `?status=success|error&reason=…` from the
# query string and renders the matching state. Defaults to
# `${WEB_BASE_URL}/auth/verify-email` — set explicitly when the verify
# page lives at a different path or hostname.
# EMAIL_VERIFIED_REDIRECT_URL="https://yourapp.com/auth/verify-email"

# Whether `/api/docs` is served. Production ignores this and never serves the
# docs — the schema dump describes every DTO and route to anonymous traffic.
# This switch only lets a NON-production environment hide them, which matters
# wherever there is no reverse proxy available to put auth in front of a staging
# deployment.
SWAGGER_ENABLED=true

CORS_ORIGIN="*"

# Global rate limit applied via @nestjs/throttler. THROTTLE_LIMIT requests
# per THROTTLE_TTL_MS window per IP. Auth/sign-up endpoints override this
# with a stricter per-route limit.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Express `trust proxy` setting. Required when the API runs behind a reverse
# proxy (nginx, ALB, Cloudflare, k8s ingress) so that req.ip and the throttler
# see the real client IP from X-Forwarded-For instead of the proxy's IP.
#   "false" = direct exposure, no proxy (default — safe for local dev)
#   "1"     = trust 1 proxy hop (typical: single nginx/ALB in front)
#   "loopback,linklocal,uniquelocal" = trust private-range proxies
#   "true"  = trust everything (UNSAFE — lets any client spoof X-Forwarded-For
#             and bypass per-IP rate limits)
TRUST_PROXY=false

# Default users created by `yarn prisma:seed`. Override these in your
# staging/prod env before running the seeder — the script refuses to run
# if either email or password is missing, and enforces the same password
# complexity the app itself enforces (12+ chars, letter + digit).
# Re-running the seeder is idempotent: existing users are left untouched.
#
# The seeder also projects the permission catalog onto the database: every
# permission, the eight system roles, and their grants. The admin gets
# PLATFORM_ADMIN + PLATFORM_USER; the regular user gets PLATFORM_USER.
# The app refuses to boot if the database and the catalog disagree.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin-local-dev-1"
SEED_USER_EMAIL="user@example.com"
SEED_USER_PASSWORD="user-local-dev-1"
