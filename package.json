{
  "name": "nestjs-api",
  "version": "1.0.0",
  "description": "Production-grade NestJS 12 + Prisma 7 + PostgreSQL + Redis API template. Auth with email verification and refresh-token rotation, DB-backed RBAC + CASL over platform and workspace scopes, Slack-style multi-tenant memberships with invitations and ownership invariants, query-level tenant isolation, soft-delete, audit log, GDPR erase, BullMQ background jobs with a splittable worker, and Swagger docs.",
  "author": "Jay Ibe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaylordibe/nestjs-api"
  },
  "bugs": {
    "url": "https://github.com/jaylordibe/nestjs-api/issues"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "typescript",
    "postgres",
    "redis",
    "api-template",
    "jwt",
    "rbac",
    "bullmq",
    "queue"
  ],
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "lint": "eslint \"{src,apps,libs,test,scripts,prisma}/**/*.ts\"",
    "lint:fix": "yarn lint --fix",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "stack:up": "docker compose up -d && docker compose --env-file .env.test up -d --wait",
    "stack:down": "docker compose down && docker compose --env-file .env.test down",
    "pretest:e2e": "docker compose --env-file .env.test up -d --wait",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "rbac:sync": "ts-node --transpile-only prisma/scripts/sync-permission-catalog.ts",
    "rbac:check": "ts-node --transpile-only prisma/scripts/check-permission-catalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0",
    "@casl/ability": "^7.0.1",
    "@casl/prisma": "^2.0.2",
    "@google-cloud/storage": "^7.22.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7",
    "@smithy/node-http-handler": "^4.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "disposable-email-domains": "^1.0.62",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.2.6",
    "multer": "^2.3.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "twilio": "^5.4.0",
    "ua-parser-js": "^2.0.9"
  },
  "resolutions": {
    "picomatch": "^4.0.4",
    "browserslist": "^4.28.7",
    "mysql2": "^3.22.0",
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "^3.1.6",
    "fast-xml-builder": "^1.1.7",
    "js-yaml": "^5.4.1",
    "multer": "^2.3.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^7",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
