generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             String?   @map("deleted_by") @db.Uuid
  isActive              Boolean   @default(true) @map("is_active")
  firstName             String    @map("first_name")
  middleName            String?   @map("middle_name")
  lastName              String    @map("last_name")
  // Unique among LIVE rows only, via partial indexes declared in the init
  // migration (`WHERE deleted_at IS NULL`). A plain @unique would let a
  // soft-deleted account hold its email/username hostage forever. Prisma
  // cannot express a partial unique index, so these must NOT carry @unique
  // or migrate would manage a conflicting full index. Look them up with
  // `findFirst`, never `findUnique`.
  //
  // Why not `@@unique([email, deletedAt])` to get `findUnique` back? Because in
  // SQL `NULL != NULL`: Postgres treats every live row's (email, NULL) as
  // distinct, so that constraint would accept TWO live users with the same
  // email while still reporting `indisunique = true`. Silent, and worse than
  // the type error it avoids. `UNIQUE ... NULLS NOT DISTINCT` (PG 15+) fixes it
  // but Prisma never emits it, so migrate would fight you forever.
  //
  // And `findFirst` costs nothing: `WHERE email = $1 AND deleted_at IS NULL`
  // is an index scan on the partial index (3 buffers over 20k rows). It is the
  // same plan `findUnique` would produce. Dropping the `deletedAt` predicate —
  // i.e. using the raw client — is what turns it into a seq scan.
  username              String?
  email                 String
  password              String
  passwordChangedAt     DateTime? @map("password_changed_at")
  failedLoginCount      Int       @default(0) @map("failed_login_count")
  lockedUntil           DateTime? @map("locked_until")
  otpHash               String?   @map("otp_hash")
  otpPurpose            String?   @map("otp_purpose")
  otpExpiresAt          DateTime? @map("otp_expires_at")
  emailVerifiedAt       DateTime? @map("email_verified_at")
  // `phoneNumber` may be set without verification (e.g. via admin
  // create or `PATCH /users/me/phone`); `phoneNumberVerifiedAt` is
  // stamped only when the OTP flow completes (POST
  // /users/me/request-phone-verification → PATCH /users/me/verify-phone).
  // Plain phone updates clear the verifiedAt — the new number hasn't
  // been proven owned, so any prior verified state is no longer valid.
  phoneNumber           String?   @map("phone_number")
  phoneNumberVerifiedAt DateTime? @map("phone_number_verified_at")
  gender                String?
  profileImageUrl       String?   @map("profile_image_url")
  birthday              DateTime? @db.Date
  timezone              String?

  deviceTokens DeviceToken[]
  // PLATFORM-scope role assignments. BUSINESS-scope roles live on
  // `businessMemberships` instead — a database constraint keeps the two from
  // crossing over (see `user_roles.scope` / `business_memberships.scope`).
  //
  // A user may hold NO platform role at all and still be a complete,
  // functioning account: their self-service capabilities come from
  // AUTHENTICATED_USER_PERMISSIONS, which the ability factory injects for
  // every authenticated caller rather than from a row in this table.
  userRoles    UserRole[]
  // Every business this person belongs to, in any capacity — staff or
  // customer, active or ended. One row per business, forever.
  memberships  BusinessMembership[]
  // Invitations this person sent. Distinct from `memberships` because an
  // inviter is not necessarily still a member by the time it is accepted.
  sentInvitations    BusinessMembership[] @relation("BusinessMembershipInviter")
  refreshTokens      RefreshToken[]

  @@map("users")
}

/// One issued refresh token.
///
/// The access token is a short-lived, stateless JWT; this table is the
/// long-lived half of a session and the authority on whether it is still alive.
/// That split is the whole point: a stateless token cannot be revoked before it
/// expires, so it is made cheap to lose by keeping it brief, and the durable
/// credential is kept somewhere it CAN be revoked.
///
/// Why a row rather than a second JWT: a refresh token must be revocable, and a
/// revocable JWT needs a server-side blocklist anyway. Since the store is
/// unavoidable, an opaque random string with the store as the single source of
/// truth is simpler than a signed token plus a store that can disagree with it.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token, hex-encoded. The token itself is returned to
  /// the client once, at issue, and never stored — a database disclosure must
  /// not hand over usable sessions.
  ///
  /// SHA-256 rather than bcrypt on purpose: this value is 256 bits of CSPRNG
  /// output, not a human-chosen password, so there is no guessing attack for a
  /// slow KDF to frustrate. A fast digest also keeps the refresh path from
  /// becoming a CPU-bound denial-of-service lever.
  tokenHash  String    @unique @map("token_hash")
  /// The session chain. Rotation issues a new row carrying the same familyId,
  /// so an entire lineage can be revoked together when replay is detected.
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  /// Stamped when this token is exchanged. Its presence is what makes replay
  /// detectable: a second exchange of the same token means the token leaked,
  /// because a well-behaved client discards it after a single use.
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Captured at issue for the audit trail — "which device was this?" is the
  /// first question asked after a suspected token theft.
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  /// Supports the retention sweep that clears expired rows.
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Authorization (RBAC + CASL)
//
// `roles` and `permissions` are a projection of
// `src/common/authorization/permission-catalog.ts`. Never hand-edit seeded
// rows: the app refuses to boot when the catalog and the database disagree.
//
// A permission row records WHAT (action + subject) and never a condition.
// `AbilityFactory` derives the WHERE from `scope` + `ownership` + request
// context. That is why there is no `condition` column here.
// ─────────────────────────────────────────────────────────────────────────

model Business {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by") @db.Uuid
  name        String
  // Unique among live rows only, via a partial index (`WHERE deleted_at IS
  // NULL`) declared in the init migration — Prisma cannot express a partial
  // unique index, so it must NOT carry `@unique` here or migrate would try to
  // manage a conflicting full index. Look it up with `findFirst`, not
  // `findUnique`.
  slug        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")

  memberships BusinessMembership[]
  invitations BusinessInvitation[]

  @@map("businesses")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  name        String   @unique
  scope       String
  // Orders roles for the privilege-escalation guard ONLY: you may assign a
  // role AT OR BELOW your own rank, never one above it. A lateral grant is not
  // an escalation — an admin appointing a peer admin gains nothing it did not
  // already have. Rank does NOT imply inherited permissions; each role's
  // grants are listed explicitly in the catalog.
  rank        Int
  description String?
  // Every role is seeded and catalog-owned — there is no endpoint that creates
  // one, so in practice this is always true. Retained as an explicit marker
  // that the row is code-owned and will be reconciled by `yarn prisma:seed`.

  permissions RolePermission[]
  userRoles   UserRole[]
  memberships BusinessMembership[]
  invitations BusinessInvitation[]

  // FK target for the scope-integrity constraint on every assignment table
  // (`user_roles`, `business_memberships`, `business_invitations`). Lets
  // `user_roles` reference `(roleId, 'platform')` so a business role can never
  // be assigned platform-wide, and vice versa.
  @@unique([id, scope])
  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Derived slug, e.g. `platform.user.update.own`. See `permissionName()`.
  name        String   @unique
  action      String
  subject     String
  scope       String
  ownership   String
  description String

  roles RolePermission[]

  @@unique([scope, action, subject, ownership])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  // Constant discriminator, not a free field. Together with the composite FK
  // below and a CHECK constraint in the migration, it makes assigning a
  // BUSINESS role platform-wide a database error rather than a code bug.
  scope     String   @default("platform")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a role must never silently strip people's
  // access. It fails loudly until every holder is reassigned.
  role Role @relation(fields: [roleId, scope], references: [id, scope], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

/// One person's relationship with one business — the ONLY such relationship
/// there is. Staff and customers are the same table distinguished by `roleId`,
/// which is what makes the platform's tenancy model Slack-shaped: one global
/// account, many businesses, exactly one role in each.
///
/// The row is created once per (business, user) pair and then moves between
/// lifecycle states forever. It is never deleted and never soft-deleted, so
/// `@@unique([businessId, userId])` is an UNCONDITIONAL database constraint —
/// see `BusinessMembershipStatus` for why soft deletion cannot express it.
///
/// ONLY `status = 'active'` grants authority. That filter lives in
/// `PermissionLoaderService`'s grant query, not in a guard: a guard runs before
/// the row is loaded and therefore cannot see a status at all.
///
/// This subject is BOTH ownable (by the person, via `userId`) and tenant-scoped
/// (by the business, via `businessId`). The two CASL rules OR-compose, so
/// someone who owns one business and is a customer of another gets exactly the
/// union of the two — with no special case in application code. See
/// SUBJECT_OWNER_KEY / SUBJECT_TENANT_KEY.
model BusinessMembership {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  /// Constant discriminator pinned to `business` by a CHECK constraint in the
  /// migration. With the composite FK below it makes attaching a PLATFORM role
  /// to a membership a database error rather than a code bug.
  scope      String    @default("business")
  /// `BusinessMembershipStatus`. A plain String, per the no-DB-enums rule —
  /// constrained by the TS enum and `@IsEnum`, so widening the lifecycle needs
  /// no migration.
  status     String    @default("active")
  /// When they first became active here. Null while merely INVITED, and
  /// preserved across a suspend/reactivate cycle so "member since" stays true.
  joinedAt   DateTime? @map("joined_at")
  /// When the relationship ended. Set alongside `status = 'left'`, cleared if
  /// they re-join on the same row.
  endedAt    DateTime? @map("ended_at")
  invitedBy  String?   @map("invited_by") @db.Uuid
  /// Staff-visible annotation on the relationship (preferences, allergies…).
  /// Gated in the service: writable only by a caller who may `update` the
  /// membership, never by the member themselves.
  notes      String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting a role must never silently strip access.
  role     Role     @relation(fields: [roleId, scope], references: [id, scope], onDelete: Restrict)
  /// SetNull, not Cascade: deleting the inviter's account must not delete the
  /// membership they created.
  inviter  User?    @relation("BusinessMembershipInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  /// The tenancy invariant. Unconditional precisely because the row is never
  /// removed — one relationship per person per business, in any state.
  @@unique([businessId, userId])
  /// Grant loading: every request resolves the caller's ACTIVE memberships.
  @@index([userId, status])
  /// Roster listing, and the owner-count check behind the last-owner invariant.
  @@index([businessId, status])
  /// Closes the otherwise-unindexed scan behind `ON DELETE RESTRICT` and the
  /// assignment count in `RolesService`. This is the large table once customers
  /// live here, so a sequential scan per role delete is not acceptable.
  @@index([roleId])
  @@map("business_memberships")
}

/// An outstanding offer to join a business.
///
/// Modelled separately from `BusinessMembership` because an invited email need
/// not belong to a user yet — there is no `userId` to hang a membership row on
/// until somebody accepts. When the invitee DOES already have an account, an
/// INVITED membership row is created alongside this one so the roster shows
/// them as pending and the (business, user) slot is reserved.
///
/// Acceptance is a conditional UPDATE out of `pending`, inside the same
/// transaction that writes the membership, so two simultaneous redemptions of
/// one token produce exactly one membership.
model BusinessInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  /// Lowercased at the DTO boundary. Deliberately NOT a FK to `users`: the
  /// whole point is that the invitee may not exist yet.
  ///
  /// Unique among PENDING rows only, via a partial index declared in the init
  /// migration (`WHERE status = 'pending'`). Prisma cannot express that, so it
  /// carries no `@@unique` here — look it up with `findFirst`, never
  /// `findUnique`.
  email      String
  roleId     String    @map("role_id") @db.Uuid
  scope      String    @default("business")
  /// SHA-256 of the opaque token, hex-encoded — the same construction, and the
  /// same reasoning, as `RefreshToken.tokenHash`. The plaintext is emailed once
  /// and never stored.
  tokenHash  String    @unique @map("token_hash")
  /// `BusinessInvitationStatus`.
  status     String    @default("pending")
  invitedBy  String?   @map("invited_by") @db.Uuid
  /// Expiry is a timestamp rather than a status, so an unattended invitation
  /// becomes unusable without any sweep having to run.
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy String?   @map("accepted_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by") @db.Uuid

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId, scope], references: [id, scope], onDelete: Restrict)

  @@index([businessId, status])
  /// Supports a retention sweep over expired invitations.
  @@index([expiresAt])
  @@map("business_invitations")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  actorId      String?  @map("actor_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String
  metadata     Json?

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  // `?action=…` filter + default `ORDER BY createdAt DESC`, and pure
  // date-range queries (no actor/target/action filter). Mirror the
  // (actorId, createdAt) / (targetUserId, createdAt) shape above. A trigram
  // GIN index on `metadata::text` for substring search is added via raw SQL
  // in the migration (Prisma can't express trigram operator classes).
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppVersion {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     String
  description String?
  platform    String
  // Distinguishes independent release trains within one platform: iOS vs
  // Android, macOS vs Windows vs Linux. They carry different version numbers,
  // stores and force-update timing, so they cannot share a row. Null for `web`,
  // which has a single distribution. Constrained to `DeviceOs` in the app layer
  // and required for any platform that has more than one train — see
  // `src/modules/app-versions/release-train-registry.ts`.
  deviceOs    String?  @map("device_os")
  releaseDate DateTime @map("release_date")
  downloadUrl String?  @map("download_url")
  forceUpdate Boolean  @default(false) @map("force_update")

  // NULL is distinct in a Postgres unique index, so this does NOT block two
  // `web` rows (deviceOs = null) from sharing a version — that gap is closed by
  // a service-level guard. For a platform with real trains (deviceOs set) it
  // enforces hard.
  @@unique([platform, deviceOs, version])
  @@index([platform, deviceOs, releaseDate])
  @@map("app_versions")
}

model DeviceToken {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  token           String   @unique
  appPlatform     String   @map("app_platform")
  deviceType      String   @map("device_type")
  deviceOs        String   @map("device_os")
  deviceOsVersion String   @map("device_os_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
