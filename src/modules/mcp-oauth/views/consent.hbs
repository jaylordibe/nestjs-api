<h1>Allow access?</h1>
<p>An application wants to use
  {{appName}}
  as
  <strong>{{userEmail}}</strong>.</p>
<dl class='client'>
  <dt>Application (name chosen by the application itself)</dt>
  <dd>{{clientName}}</dd>
  <dt>After you choose, you will be sent to</dt>
  <dd class='redirect'>{{redirectUri}}</dd>
</dl>
<p class='muted'>Only allow this if you started the connection and recognise the
  address above. The application will be able to use
  {{appName}}'s MCP tools as you until you sign out everywhere or change your
  password.</p>
<form method='post' action='{{action}}'>
  <input type='hidden' name='formToken' value='{{formToken}}' />
  <div class='actions'>
    <button type='submit' name='decision' value='deny'>Deny</button>
    <button
      type='submit'
      name='decision'
      value='approve'
      class='primary'
    >Allow</button>
  </div>
</form>