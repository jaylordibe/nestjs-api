<!doctype html>
<html>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.5; color: #111; max-width: 480px; margin: 0 auto; padding: 24px;">
    <h1 style="font-size: 20px; margin: 0 0 16px;">Join {{businessName}}</h1>
    <p>{{inviterName}} has invited you to join <strong>{{businessName}}</strong> as {{roleName}}.</p>
    <p style="margin: 32px 0;">
      <a href="{{{acceptUrl}}}" style="display: inline-block; background: #111; color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 600;">Accept invitation</a>
    </p>
    <p style="color: #666; font-size: 14px;">Or paste this link into your browser:</p>
    <p style="color: #666; font-size: 13px; word-break: break-all;"><a href="{{{acceptUrl}}}" style="color: #666;">{{{acceptUrl}}}</a></p>
    <p style="color: #666; font-size: 14px; margin-top: 24px;">This invitation expires in {{expiresInDays}} days and can be used once. If you weren't expecting it, you can safely ignore this email.</p>
  </body>
</html>
