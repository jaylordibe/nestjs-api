<!doctype html>
<html>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.5; color: #111; max-width: 480px; margin: 0 auto; padding: 24px;">
    <h1 style="font-size: 20px; margin: 0 0 16px;">Reset your password</h1>
    <p>Hi {{firstName}},</p>
    <p>Click the button below to choose a new password:</p>
    <p style="margin: 32px 0;">
      <a href="{{{resetUrl}}}" style="display: inline-block; background: #111; color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 600;">Reset my password</a>
    </p>
    <p style="color: #666; font-size: 14px;">Or paste this link into your browser:</p>
    <p style="color: #666; font-size: 13px; word-break: break-all;"><a href="{{{resetUrl}}}" style="color: #666;">{{{resetUrl}}}</a></p>
    <p style="color: #666; font-size: 14px; margin-top: 24px;">This link expires in {{expiresInMinutes}} minutes and works once. If you didn't request a password reset, you can safely ignore this email — your password hasn't changed.</p>
  </body>
</html>
