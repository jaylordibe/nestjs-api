<html>
  <body
    style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.5; color: #111; max-width: 480px; margin: 0 auto; padding: 24px;"
  >
    <h1 style='font-size: 20px; margin: 0 0 16px;'>Your email address was
      changed</h1>
