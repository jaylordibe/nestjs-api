      "PowerShell(gh pr close *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh release *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(yarn prisma:migrate *)",
      "PowerShell(yarn prisma:deploy *)",
      "PowerShell(yarn prisma:reset *)",
      "PowerShell(yarn prisma:seed *)",
      "PowerShell(yarn prisma migrate *)",
      "PowerShell(yarn prisma db *)",
      "PowerShell(npx prisma migrate *)",
      "PowerShell(npx prisma db *)",
      "PowerShell(prisma migrate *)",
      "PowerShell(prisma db *)",
      "PowerShell(docker compose down *)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker volume prune *)",
      "PowerShell(docker system prune *)",
      "PowerShell(dropdb *)",
      "PowerShell(npm publish *)",
      "PowerShell(yarn publish *)",
      "PowerShell(yarn npm publish *)",
      "PowerShell(docker push *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.staging)",
      "Edit(.env.production)",
      "Edit(.env.*.local)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "mcp__*__*transition*",
      "mcp__*__*Transition*",
      "mcp__*__editJiraIssue",
      "mcp__*__updateJiraIssue",
      "mcp__*__deleteJiraIssue",
      "mcp__*__assignJiraIssue",
      "mcp__*__addWorklogToJiraIssue",
      "mcp__*__*IssueField*",
      "mcp__*__*issueField*"
    ],
    "ask": [
      "Bash(psql *)",
      "Bash(docker exec *)",
      "Bash(pg_dump *)",
      "Bash(redis-cli *)",
      "Bash(gh api *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "PowerShell(psql *)",
      "PowerShell(docker exec *)",
      "PowerShell(pg_dump *)",
      "PowerShell(redis-cli *)",
      "PowerShell(gh api *)",
      "PowerShell(git worktree *)",
      "PowerShell(git branch *)",
      "mcp__*__createJiraIssue",
      "mcp__*__createIssueLink",
      "mcp__*__*CreateIssue*",
      "mcp__*__*createIssue*",
      "Bash(yarn start:worker *)",
      "PowerShell(yarn start:worker *)",
      "Bash(yarn start:worker:dev *)",
      "PowerShell(yarn start:worker:dev *)",
      "Bash(yarn prisma:studio *)",
      "PowerShell(yarn prisma:studio *)",
      "Bash(yarn test:watch *)",
      "PowerShell(yarn test:watch *)",
      "Bash(yarn test:debug *)",
      "PowerShell(yarn test:debug *)",
      "Bash(yarn rbac:sync *)",
      "PowerShell(yarn rbac:sync *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(yarn install *)",
      "Bash(yarn build *)",
      "Bash(yarn lint *)",
      "Bash(yarn format *)",
      "Bash(yarn test *)",
      "Bash(yarn test:e2e *)",
      "Bash(yarn prisma:generate *)",
      "Bash(yarn claude:validate *)",
      "Bash(yarn stack:up *)",
      "Bash(yarn stack:down *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(yarn test:cov *)",
      "Bash(yarn pretest:e2e *)",
      "Bash(yarn start *)",
      "Bash(yarn start:dev *)",
      "Bash(yarn start:debug *)",
      "Bash(yarn start:prod *)",
      "Bash(yarn rbac:check *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-dangerous-commands.sh",
            "statusMessage": "Guard: human-owned operation"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-paths.sh",
            "statusMessage": "Guard: protected path"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-changed-file.sh",
            "statusMessage": "Formatting changed file"
          }
        ]
      }
    ]
  }
}
